{
    "name": "bakewizard/blogger",
    "description": "Blogger plugin for BakeKit CMS",
    "license": "MIT",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "blogging", "posts", "bakekit"],
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "5.2.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.5 || ^11.1.3"
    },
    "autoload": {
        "psr-4": {
            "Blogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blogger\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
